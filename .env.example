# ── Supabase ──────────────────────────────────────────────────────────────
# Local: run `supabase start` then `supabase status` to get these.
# Hosted: Project Settings → API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=          # anon/publishable key — safe in the browser (Auth only)
SUPABASE_SERVICE_ROLE_KEY=         # secret — backend only, bypasses RLS

# Postgres connection string used by the LangGraph checkpointer.
# Use the Session pooler string (port 5432); URL-encode special chars in the password.
DATABASE_URL=

# ── LLM ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Email reminders (optional; falls back to no-send if unset) ─────────────
RESEND_API_KEY=
REMINDER_FROM_EMAIL=onboarding@resend.dev

# ── Storage (optional; has a sensible default) ─────────────────────────────
# DOCUMENTS_BUCKET=patient-documents
